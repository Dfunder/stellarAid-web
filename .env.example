# StellarAid environment variables
# No application environment variables are currently read by the app.
# Add entries here with safe placeholder values when introducing new variables.
# Example placeholders:
# NEXT_PUBLIC_STELLAR_NETWORK=testnet
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Canonical deployment URL — robots.ts disallows indexing when this does not match
# NEXT_PUBLIC_SITE_URL=https://stellaraid.vercel.app
