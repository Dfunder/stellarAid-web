# Lumora web environment configuration.
# Copy this file to `.env` and adjust the values, then restart the dev server.
#
# All variables are required in a production (`vite build`) run. Production
# builds with a missing or wrong variable refuse to start and render an error
# screen — the app never silently falls back to localhost or the testnet.

# Base URL of the Lumora backend / API. Must use https in production.
VITE_API_URL=http://localhost:4000

# Stellar network to connect to: testnet or mainnet. Required in production.
VITE_STELLAR_NETWORK=testnet

# Public URL the web app is served from (links, redirects and SEO).
# Must use https in production.
VITE_APP_URL=http://localhost:5173
# Optional feature-flag overrides ("true" or "false"). Unset = flag's safe default (off).
# VITE_FF_MESSAGING=false
# VITE_FF_NOTIFICATIONS=false
# VITE_FF_ADVANCED_FILTERS=false
