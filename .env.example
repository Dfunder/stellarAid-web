# Lumora web environment configuration.
# Copy this file to `.env` and adjust the values, then restart the dev server.
# Required (no defaults — the app refuses to boot without them, in every build mode):
#   VITE_API_URL, VITE_STELLAR_NETWORK, VITE_APP_URL
# Optional: VITE_FF_MESSAGING, VITE_FF_NOTIFICATIONS, VITE_FF_ADVANCED_FILTERS
#
# Base URL of the Lumora backend / API. Must be https:// — auth tokens are sent in
# Authorization headers, so plaintext HTTP is rejected. For local development,
# terminate TLS in front of your API (e.g. an `https://api.localhost` dev proxy).
VITE_API_URL=https://api.localhost

# Stellar network to connect to: exactly "testnet" or "mainnet".
# Anything else (including "futurenet") is rejected.
VITE_STELLAR_NETWORK=testnet

# Public URL the web app is served from (links, redirects and SEO).
VITE_APP_URL=https://app.localhost

# Optional feature-flag overrides ("true" or "false"). Unset = flag's safe default (off).
# VITE_FF_MESSAGING=false
# VITE_FF_NOTIFICATIONS=false
# VITE_FF_ADVANCED_FILTERS=false
