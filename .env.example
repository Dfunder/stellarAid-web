# =============================================================================
# WARNING: every VITE_* variable is compiled into the PUBLIC client bundle.
# Anyone who loads the site can read these values. Never put a secret (API
# key, signing key, password, token) in a VITE_* variable - secrets belong on a
# server, not in this file.
# =============================================================================
#
# Lumora web environment configuration.
# Copy this file to `.env` and adjust the values, then restart the dev server.
#
# The three variables below are the only required ones. A production build must
# set all three explicitly: there is no production fallback, so a missing value
# renders the configuration error screen instead of silently starting against
# localhost or testnet. In production `VITE_API_URL` must use https://, because
# session tokens travel over that connection. The development server falls back
# to the localhost defaults shown below only when a variable is unset.

# Base URL of the Lumora backend / API. Production must be an https:// origin.
VITE_API_URL=http://localhost:4000

# Stellar network to connect to: testnet or mainnet. Production has no default.
VITE_STELLAR_NETWORK=testnet

# Public URL the web app is served from (links, redirects and SEO).
VITE_APP_URL=http://localhost:5173

# Optional feature-flag overrides ("true" or "false"). Unset = the flag's safe default (off).
# VITE_FF_MESSAGING=false
# VITE_FF_NOTIFICATIONS=false
# VITE_FF_ADVANCED_FILTERS=false
