# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# API Base URL - Your backend API endpoint
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Stellar Network - Can be 'testnet' or 'mainnet'
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Stellar USDC Asset Code - The asset code for USDC on Stellar
NEXT_PUBLIC_USDC_ASSET_CODE=USDC

# Stellar USDC Issuer - The issuing account for USDC on Stellar
NEXT_PUBLIC_USDC_ISSUER=GA5ZSEJYB37JDD5G4LYXOCMDSBXN7DJ62T4YZ2JIKdzAWGN7QAKV3RKD