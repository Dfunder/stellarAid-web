# EditorConfig helps keep formatting consistent across editors: https://editorconfig.org
# Values mirror .prettierrc (tabWidth 2, endOfLine lf).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Trailing double-space is a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
