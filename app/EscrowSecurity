#![cfg(test)]

use std::collections::HashMap;

// ============================================================
// TYPES
// ============================================================

pub type Address = String;
pub type EscrowId = u64;

#[derive(Debug, Clone, PartialEq, Eq)]
pub enum EscrowStatus {
    Created,
    Funded,
    Released,
    Refunded,
    Cancelled,
}

#[derive(Debug, Clone)]
pub struct Escrow {
    pub id: EscrowId,
    pub payer: Address,
    pub payee: Address,
    pub arbiter: Address,
    pub amount: i128,
    pub funded_amount: i128,
    pub status: EscrowStatus,
    pub created_at: u64,
    pub release_after: Option<u64>,
}

// ============================================================
// ERRORS
// ============================================================

#[derive(Debug, Clone, PartialEq, Eq)]
pub enum EscrowError {
    EscrowNotFound,
    Unauthorized,
    InvalidAmount,
    InvalidAddress,
    AlreadyFunded,
    InsufficientFunding,
    InvalidState,
    AlreadyReleased,
    AlreadyRefunded,
    AlreadyCancelled,
    ReleaseTooEarly,
    EscrowExpired,
    CannotRefund,
    CannotRelease,
    ArithmeticOverflow,
}

// ============================================================
// ESCROW SERVICE
// ============================================================

pub struct EscrowService {
    escrows: HashMap<EscrowId, Escrow>,
    balances: HashMap<Address, i128>,
    next_id: EscrowId,
}

impl Default for EscrowService {
    fn default() -> Self {
        Self::new()
    }
}

impl EscrowService {
    // ========================================================
    // CONSTRUCTOR
    // ========================================================

    pub fn new() -> Self {
        Self {
            escrows: HashMap::new(),
            balances: HashMap::new(),
            next_id: 1,
        }
    }

    // ========================================================
    // TEST BALANCE HELPERS
    // ========================================================

    pub fn set_balance(
        &mut self,
        address: Address,
        amount: i128,
    ) -> Result<(), EscrowError> {
        if amount < 0 {
            return Err(EscrowError::InvalidAmount);
        }

        self.balances.insert(address, amount);

        Ok(())
    }

    pub fn balance_of(
        &self,
        address: &Address,
    ) -> i128 {
        *self
            .balances
            .get(address)
            .unwrap_or(&0)
    }

    // ========================================================
    // CREATE ESCROW
    // ========================================================

    pub fn create_escrow(
        &mut self,
        payer: Address,
        payee: Address,
        arbiter: Address,
        amount: i128,
        created_at: u64,
        release_after: Option<u64>,
    ) -> Result<EscrowId, EscrowError> {

        // ----------------------------------------------------
        // SECURITY: VALIDATE ADDRESSES
        // ----------------------------------------------------

        if payer.is_empty()
            || payee.is_empty()
            || arbiter.is_empty()
        {
            return Err(
                EscrowError::InvalidAddress
            );
        }

        // ----------------------------------------------------
        // SECURITY: PAYER AND PAYEE MUST DIFFER
        // ----------------------------------------------------

        if payer == payee {
            return Err(
                EscrowError::InvalidAddress
            );
        }

        // ----------------------------------------------------
        // SECURITY: POSITIVE AMOUNT
        // ----------------------------------------------------

        if amount <= 0 {
            return Err(
                EscrowError::InvalidAmount
            );
        }

        // ----------------------------------------------------
        // SECURITY: RELEASE TIME MUST NOT BE IN THE PAST
        // ----------------------------------------------------

        if let Some(release_time) =
            release_after
        {
            if release_time < created_at {
                return Err(
                    EscrowError::ReleaseTooEarly
                );
            }
        }

        let id =
            self.next_id;

        self.next_id =
            self.next_id
                .checked_add(1)
                .ok_or(
                    EscrowError::ArithmeticOverflow
                )?;

        let escrow =
            Escrow {
                id,
                payer,
                payee,
                arbiter,
                amount,
                funded_amount: 0,
                status:
                    EscrowStatus::Created,
                created_at,
                release_after,
            };

        self.escrows.insert(
            id,
            escrow,
        );

        Ok(id)
    }

    // ========================================================
    // FUND ESCROW
    // ========================================================

    pub fn fund_escrow(
        &mut self,
        caller: &Address,
        escrow_id: EscrowId,
        amount: i128,
    ) -> Result<(), EscrowError> {

        if amount <= 0 {
            return Err(
                EscrowError::InvalidAmount
            );
        }

        let escrow =
            self.escrows
                .get(&escrow_id)
                .ok_or(
                    EscrowError::EscrowNotFound
                )?
                .clone();

        // ----------------------------------------------------
        // SECURITY: ONLY PAYER MAY FUND
        // ----------------------------------------------------

        if &escrow.payer != caller {
            return Err(
                EscrowError::Unauthorized
            );
        }

        // ----------------------------------------------------
        // SECURITY: ESCROW MUST NOT ALREADY BE TERMINAL
        // ----------------------------------------------------

        match escrow.status {
            EscrowStatus::Released
            | EscrowStatus::Refunded
            | EscrowStatus::Cancelled => {
                return Err(
                    EscrowError::InvalidState
                );
            }

            _ => {}
        }

        // ----------------------------------------------------
        // SECURITY: PREVENT DOUBLE FUNDING
        // ----------------------------------------------------

        if escrow.funded_amount > 0 {
            return Err(
                EscrowError::AlreadyFunded
            );
        }

        // ----------------------------------------------------
        // SECURITY: EXACT AMOUNT REQUIRED
        // ----------------------------------------------------

        if amount != escrow.amount {
            return Err(
                EscrowError::InsufficientFunding
            );
        }

        let balance =
            self.balance_of(
                caller,
            );

        if balance < amount {
            return Err(
                EscrowError::InsufficientFunding
            );
        }

        let new_balance =
            balance
                .checked_sub(amount)
                .ok_or(
                    EscrowError::ArithmeticOverflow
                )?;

        self.balances.insert(
            caller.clone(),
            new_balance,
        );

        let escrow =
            self.escrows
                .get_mut(&escrow_id)
                .ok_or(
                    EscrowError::EscrowNotFound
                )?;

        escrow.funded_amount =
            amount;

        escrow.status =
            EscrowStatus::Funded;

        Ok(())
    }

    // ========================================================
    // RELEASE ESCROW
    // ========================================================

    pub fn release_escrow(
        &mut self,
        caller: &Address,
        escrow_id: EscrowId,
        now: u64,
    ) -> Result<(), EscrowError> {

        let escrow =
            self.escrows
                .get(&escrow_id)
                .ok_or(
                    EscrowError::EscrowNotFound
                )?
                .clone();

        // ----------------------------------------------------
        // SECURITY: ONLY AUTHORIZED ACTORS MAY RELEASE
        // ----------------------------------------------------

        let authorized =
            caller == &escrow.payer
                || caller == &escrow.arbiter;

        if !authorized {
            return Err(
                EscrowError::Unauthorized
            );
        }

        // ----------------------------------------------------
        // SECURITY: VALID STATE
        // ----------------------------------------------------

        if escrow.status
            != EscrowStatus::Funded
        {
            return Err(
                EscrowError::CannotRelease
            );
        }

        // ----------------------------------------------------
        // SECURITY: FULLY FUNDED
        // ----------------------------------------------------

        if escrow.funded_amount
            != escrow.amount
        {
            return Err(
                EscrowError::InsufficientFunding
            );
        }

        // ----------------------------------------------------
        // SECURITY: TIME LOCK
        // ----------------------------------------------------

        if let Some(release_after) =
            escrow.release_after
        {
            if now < release_after {
                return Err(
                    EscrowError::ReleaseTooEarly
                );
            }
        }

        // ----------------------------------------------------
        // SECURITY: TRANSFER ONLY ONCE
        // ----------------------------------------------------

        let payee_balance =
            self.balance_of(
                &escrow.payee,
            );

        let new_balance =
            payee_balance
                .checked_add(
                    escrow.funded_amount,
                )
                .ok_or(
                    EscrowError::ArithmeticOverflow
                )?;

        self.balances.insert(
            escrow.payee.clone(),
            new_balance,
        );

        let escrow =
            self.escrows
                .get_mut(&escrow_id)
                .ok_or(
                    EscrowError::EscrowNotFound
                )?;

        escrow.funded_amount =
            0;

        escrow.status =
            EscrowStatus::Released;

        Ok(())
    }

    // ========================================================
    // REFUND ESCROW
    // ========================================================

    pub fn refund_escrow(
        &mut self,
        caller: &Address,
        escrow_id: EscrowId,
        now: u64,
    ) -> Result<(), EscrowError> {

        let escrow =
            self.escrows
                .get(&escrow_id)
                .ok_or(
                    EscrowError::EscrowNotFound
                )?
                .clone();

        // ----------------------------------------------------
        // SECURITY: ONLY PAYER OR ARBITER
        // ----------------------------------------------------

        if caller != &escrow.payer
            && caller != &escrow.arbiter
        {
            return Err(
                EscrowError::Unauthorized
            );
        }

        // ----------------------------------------------------
        // SECURITY: ONLY FUNDED ESCROWS
        // ----------------------------------------------------

        if escrow.status
            != EscrowStatus::Funded
        {
            return Err(
                EscrowError::CannotRefund
            );
        }

        // ----------------------------------------------------
        // SECURITY: REFUND ONLY AFTER RELEASE DEADLINE
        // ----------------------------------------------------

        if let Some(release_after) =
            escrow.release_after
        {
            if now < release_after {
                return Err(
                    EscrowError::ReleaseTooEarly
                );
            }
        }

        // ----------------------------------------------------
        // RETURN FUNDS TO PAYER
        // ----------------------------------------------------

        let payer_balance =
            self.balance_of(
                &escrow.payer,
            );

        let new_balance =
            payer_balance
                .checked_add(
                    escrow.funded_amount,
                )
                .ok_or(
                    EscrowError::ArithmeticOverflow
                )?;

        self.balances.insert(
            escrow.payer.clone(),
            new_balance,
        );

        // ----------------------------------------------------
        // MARK AS REFUNDED
        // ----------------------------------------------------

        let escrow =
            self.escrows
                .get_mut(&escrow_id)
                .ok_or(
                    EscrowError::EscrowNotFound
                )?;

        escrow.funded_amount =
            0;

        escrow.status =
            EscrowStatus::Refunded;

        Ok(())
    }

    // ========================================================
    // CANCEL ESCROW
    // ========================================================

    pub fn cancel_escrow(
        &mut self,
        caller: &Address,
        escrow_id: EscrowId,
    ) -> Result<(), EscrowError> {

        let escrow =
            self.escrows
                .get(&escrow_id)
                .ok_or(
                    EscrowError::EscrowNotFound
                )?
                .clone();

        // ----------------------------------------------------
        // SECURITY: ONLY PAYER CAN CANCEL
        // ----------------------------------------------------

        if caller != &escrow.payer {
            return Err(
                EscrowError::Unauthorized
            );
        }

        // ----------------------------------------------------
        // SECURITY: CANNOT CANCEL FUNDED ESCROW
        // ----------------------------------------------------

        if escrow.status
            != EscrowStatus::Created
        {
            return Err(
                EscrowError::InvalidState
            );
        }

        let escrow =
            self.escrows
                .get_mut(&escrow_id)
                .ok_or(
                    EscrowError::EscrowNotFound
                )?;

        escrow.status =
            EscrowStatus::Cancelled;

        Ok(())
    }

    // ========================================================
    // GET ESCROW
    // ========================================================

    pub fn get_escrow(
        &self,
        escrow_id: EscrowId,
    ) -> Result<&Escrow, EscrowError> {

        self.escrows
            .get(&escrow_id)
            .ok_or(
                EscrowError::EscrowNotFound
            )
    }
}

