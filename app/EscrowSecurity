// TEST HELPERS
// ============================================================

fn setup() -> (
    EscrowService,
    Address,
    Address,
    Address,
    Address,
) {

    let payer =
        "payer".to_string();

    let payee =
        "payee".to_string();

    let arbiter =
        "arbiter".to_string();

    let attacker =
        "attacker".to_string();

    let mut service =
        EscrowService::new();

    service
        .set_balance(
            payer.clone(),
            1_000,
        )
        .unwrap();

    service
        .set_balance(
            payee.clone(),
            0,
        )
        .unwrap();

    service
        .set_balance(
            arbiter.clone(),
            0,
        )
        .unwrap();

    service
        .set_balance(
            attacker.clone(),
            1_000,
        )
        .unwrap();

    (
        service,
        payer,
        payee,
        arbiter,
        attacker,
    )
}

