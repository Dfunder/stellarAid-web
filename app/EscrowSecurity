    // ========================================================
    // SECURITY REGRESSION TEST
    // ========================================================

    #[test]
    fn complete_secure_escrow_lifecycle() {

        let (
            mut service,
            payer,
            payee,
            arbiter,
            attacker,
        ) = setup();

        // ----------------------------------------------------
        // CREATE
        // ----------------------------------------------------

        let id =
            service
                .create_escrow(
                    payer.clone(),
                    payee.clone(),
                    arbiter.clone(),
                    250,
                    1,
                    Some(100),
                )
                .unwrap();

        // ----------------------------------------------------
        // ATTACKER CANNOT FUND
        // ----------------------------------------------------

        assert_eq!(
            service.fund_escrow(
                &attacker,
                id,
                250,
            ),
            Err(
                EscrowError::Unauthorized
            )
        );

        // ----------------------------------------------------
        // PAYER FUNDS
        // ----------------------------------------------------

        service
            .fund_escrow(
                &payer,
                id,
                250,
            )
            .unwrap();

        // ----------------------------------------------------
        // ATTACKER CANNOT RELEASE
        // ----------------------------------------------------

        assert_eq!(
            service.release_escrow(
                &attacker,
                id,
                100,
            ),
            Err(
                EscrowError::Unauthorized
            )
        );

        // ----------------------------------------------------
        // RELEASE
        // ----------------------------------------------------

        service
            .release_escrow(
                &arbiter,
                id,
                100,
            )
            .unwrap();

        // ----------------------------------------------------
        // PAYMENT MUST EXIST EXACTLY ONCE
        // ----------------------------------------------------

        assert_eq!(
            service.balance_of(&payee),
            250
        );

        // ----------------------------------------------------
        // SECOND RELEASE MUST FAIL
        // ----------------------------------------------------

        assert_eq!(
            service.release_escrow(
                &arbiter,
                id,
                101,
            ),
            Err(
                EscrowError::CannotRelease
            )
        );

        // ----------------------------------------------------
        // NO SECOND PAYMENT
        // ----------------------------------------------------

        assert_eq!(
            service.balance_of(&payee),
            250
        );
    }
