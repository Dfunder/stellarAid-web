    #[test]
    fn should_create_valid_escrow() {

        let (
            mut service,
            payer,
            payee,
            arbiter,
            _,
        ) = setup();

        let id =
            service
                .create_escrow(
                    payer,
                    payee,
                    arbiter,
                    100,
                    10,
                    Some(20),
                )
                .unwrap();

        let escrow =
            service
                .get_escrow(id)
                .unwrap();

        assert_eq!(
            escrow.amount,
            100
        );

        assert_eq!(
            escrow.status,
            EscrowStatus::Created
        );
    }

