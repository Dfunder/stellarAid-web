import {
  Injectable,
  Logger,
} from '@nestjs/common';

import {
  Test,
  TestingModule,
} from '@nestjs/testing';

// ============================================================
// TYPES
// ============================================================

type HookName =
  | 'beforeCreate'
  | 'afterCreate'
  | 'beforeUpdate'
  | 'afterUpdate'
  | 'beforeDelete'
  | 'afterDelete';

interface HookContext {
  entity: string;
  entityId?: string;
  operation: HookName;
  data?: Record<string, unknown>;
  metadata?: Record<string, unknown>;
}

type HookHandler =
  (
    context: HookContext,
  ) => Promise<void> | void;

interface RegisteredHook {
  name: string;
  operation: HookName;
  handler: HookHandler;
  priority: number;
  enabled: boolean;
}

// ============================================================
// HOOK SERVICE
// ============================================================

@Injectable()
class HookService {

  private readonly hooks =
    new Map<
      HookName,
      RegisteredHook[]
    >();

  private readonly executionLog:
    string[] = [];

  private readonly logger =
    new Logger(
      HookService.name,
    );

  // ==========================================================
  // REGISTER
  // ==========================================================

  register(
    hook: RegisteredHook,
  ): void {

    const existing =
      this.hooks.get(
        hook.operation,
      ) ?? [];

    existing.push(
      hook,
    );

    existing.sort(
      (
        first,
        second,
      ) =>
        first.priority -
        second.priority,
    );

    this.hooks.set(
      hook.operation,
      existing,
    );
  }

  // ==========================================================
  // UNREGISTER
  // ==========================================================

  unregister(
    hookName: string,
    operation: HookName,
  ): boolean {

    const existing =
      this.hooks.get(
        operation,
      ) ?? [];

    const originalLength =
      existing.length;

    const filtered =
      existing.filter(
        hook =>
          hook.name !==
          hookName,
      );

    this.hooks.set(
      operation,
      filtered,
    );

    return (
      filtered.length !==
      originalLength
    );
  }

  // ==========================================================
  // ENABLE
  // ==========================================================

  enable(
    hookName: string,
    operation: HookName,
  ): boolean {

    const hook =
      this.findHook(
        hookName,
        operation,
      );

    if (!hook) {

      return false;
    }

    hook.enabled =
      true;

    return true;
  }

  // ==========================================================
  // DISABLE
  // ==========================================================

  disable(
    hookName: string,
    operation: HookName,
  ): boolean {

    const hook =
      this.findHook(
        hookName,
        operation,
      );

    if (!hook) {

      return false;
    }

    hook.enabled =
      false;

    return true;
  }

  // ==========================================================
  // EXECUTE
  // ==========================================================

  async execute(
    operation: HookName,
    context: Omit<
      HookContext,
      'operation'
    >,
  ): Promise<void> {

    const hooks =
      this.hooks.get(
        operation,
      ) ?? [];

    const fullContext:
      HookContext = {
        ...context,

        operation,
      };

    for (
      const hook of hooks
    ) {

      if (
        !hook.enabled
      ) {

        continue;
      }

      try {

        this.executionLog.push(
          `${operation}:${hook.name}:start`,
        );

        await hook.handler(
          fullContext,
        );

        this.executionLog.push(
          `${operation}:${hook.name}:success`,
        );

      } catch (
        error
      ) {

        this.executionLog.push(
          `${operation}:${hook.name}:failure`,
        );

        this.logger.error(
          `Hook ${hook.name} failed`,
          error instanceof Error
            ? error.stack
            : String(error),
        );

        throw error;
      }
    }
  }

  // ==========================================================
  // FIND HOOK
  // ==========================================================

  private findHook(
    hookName: string,
    operation: HookName,
  ): RegisteredHook | undefined {

    return (
      this.hooks
        .get(operation)
        ?.find(
          hook =>
            hook.name ===
            hookName,
        )
    );
  }

  // ==========================================================
  // GET HOOKS
  // ==========================================================

  getHooks(
    operation: HookName,
  ): RegisteredHook[] {

    return [
      ...(this.hooks.get(
        operation,
      ) ?? []),
    ];
  }

  // ==========================================================
  // GET EXECUTION LOG
  // ==========================================================

  getExecutionLog(): string[] {

    return [
      ...this.executionLog,
    ];
  }

  // ==========================================================
  // CLEAR
  // ==========================================================

  clear(): void {

    this.hooks.clear();

    this.executionLog.length =
      0;
  }
}

// ============================================================
// ENTITY SERVICE USING HOOKS
// ============================================================

@Injectable()
class EntityService {

  private readonly entities =
    new Map<
      string,
      Record<string, unknown>
    >();

  constructor(
    private readonly hooks:
      HookService,
  ) {}

  // ==========================================================
  // CREATE
  // ==========================================================

  async create(
    entityId: string,
    data: Record<string, unknown>,
  ) {

    await this.hooks.execute(
      'beforeCreate',
      {
        entity:
          'TestEntity',

        entityId,

        data,
      },
    );

    const entity = {
      id:
        entityId,

      ...data,
    };

    this.entities.set(
      entityId,
      entity,
    );

    await this.hooks.execute(
      'afterCreate',
      {
        entity:
          'TestEntity',

        entityId,

        data:
          entity,
      },
    );

    return entity;
  }

  // ==========================================================
  // UPDATE
  // ==========================================================

  async update(
    entityId: string,
    data: Record<string, unknown>,
  ) {

    await this.hooks.execute(
      'beforeUpdate',
      {
        entity:
          'TestEntity',

        entityId,

        data,
      },
    );

    const existing =
      this.entities.get(
        entityId,
      ) ?? {
        id:
          entityId,
      };

    const updated = {
      ...existing,
      ...data,
    };

    this.entities.set(
      entityId,
      updated,
    );

    await this.hooks.execute(
      'afterUpdate',
      {
        entity:
          'TestEntity',

        entityId,

        data:
          updated,
      },
    );

    return updated;
  }

  // ==========================================================
  // DELETE
  // ==========================================================

  async delete(
    entityId: string,
  ): Promise<void> {

    await this.hooks.execute(
      'beforeDelete',
      {
        entity:
          'TestEntity',

        entityId,
      },
    );

    this.entities.delete(
      entityId,
    );

    await this.hooks.execute(
      'afterDelete',
      {
        entity:
          'TestEntity',

        entityId,
      },
    );
  }

  // ==========================================================
  // FIND
  // ==========================================================

  find(
    entityId: string,
  ) {

    return this.entities.get(
      entityId,
    );
  }
}

// ============================================================
// TEST SUITE
// ============================================================

describe(
  'Hook Unit Tests',
  () => {

    let hooks:
      HookService;

    let entities:
      EntityService;

    // ========================================================
    // SETUP
    // ========================================================

    beforeEach(
      async () => {

        const module:
          TestingModule =
          await Test.createTestingModule({
            providers: [
              HookService,

              EntityService,
            ],
          }).compile();

        hooks =
          module.get(
            HookService,
          );

        entities =
          module.get(
            EntityService,
          );
      },
    );

    // ========================================================
    // CLEANUP
    // ========================================================

    afterEach(
      () => {

        hooks.clear();
      },
    );

    // ========================================================
    // REGISTRATION
    // ========================================================

    describe(
      'Hook registration',
      () => {

        it(
          'should register a hook',
          () => {

            const handler =
              jest.fn();

            hooks.register({
              name:
                'audit-create',

              operation:
                'beforeCreate',

              handler,

              priority:
                10,

              enabled:
                true,
            });

            const registered =
              hooks.getHooks(
                'beforeCreate',
              );

            expect(
              registered,
            ).toHaveLength(
              1,
            );

            expect(
              registered[0].name,
            ).toBe(
              'audit-create',
            );
          },
        );

        it(
          'should support multiple hooks',
          () => {

            hooks.register({
              name:
                'hook-one',

              operation:
                'beforeCreate',

              handler:
                jest.fn(),

              priority:
                10,

              enabled:
                true,
            });

            hooks.register({
              name:
                'hook-two',

              operation:
                'beforeCreate',

              handler:
                jest.fn(),

              priority:
                20,

              enabled:
                true,
            });

            expect(
              hooks.getHooks(
                'beforeCreate',
              ),
            ).toHaveLength(
              2,
            );
          },
        );
      },
    );

    // ========================================================
    // EXECUTION
    // ========================================================

    describe(
      'Hook execution',
      () => {

        it(
          'should execute a registered hook',
          async () => {

            const handler =
              jest.fn();

            hooks.register({
              name:
                'test-hook',

              operation:
                'beforeCreate',

              handler,

              priority:
                10,

              enabled:
                true,
            });

            await hooks.execute(
              'beforeCreate',
              {
                entity:
                  'TestEntity',

                entityId:
                  'entity-1',

                data: {
                  name:
                    'Example',
                },
              },
            );

            expect(
              handler,
            ).toHaveBeenCalledTimes(
              1,
            );
          },
        );

        it(
          'should pass the complete context',
          async () => {

            const handler =
              jest.fn();

            hooks.register({
              name:
                'context-hook',

              operation:
                'beforeCreate',

              handler,

              priority:
                10,

              enabled:
                true,
            });

            await hooks.execute(
              'beforeCreate',
              {
                entity:
                  'User',

                entityId:
                  'user-123',

                data: {
                  email:
                    'user@example.com',
                },

                metadata: {
                  source:
                    'mobile',
                },
              },
            );

            expect(
              handler,
            ).toHaveBeenCalledWith({
              entity:
                'User',

              entityId:
                'user-123',

              operation:
                'beforeCreate',

              data: {
                email:
                  'user@example.com',
              },

              metadata: {
                source:
                  'mobile',
              },
            });
          },
        );

        it(
          'should not execute unrelated hooks',
          async () => {

            const beforeCreate =
              jest.fn();

            const afterCreate =
              jest.fn();

            hooks.register({
              name:
                'before',

              operation:
                'beforeCreate',

              handler:
                beforeCreate,

              priority:
                10,

              enabled:
                true,
            });

            hooks.register({
              name:
                'after',

              operation:
                'afterCreate',

              handler:
                afterCreate,

              priority:
                10,

              enabled:
                true,
            });

            await hooks.execute(
              'beforeCreate',
              {
                entity:
                  'User',
              },
            );

            expect(
              beforeCreate,
            ).toHaveBeenCalled();

            expect(
              afterCreate,
            ).not.toHaveBeenCalled();
          },
        );
      },
    );

    // ========================================================
    // ASYNC HOOKS
    // ========================================================

    describe(
      'Async hooks',
      () => {

        it(
          'should await asynchronous hooks',
          async () => {

            const events:
              string[] = [];

            hooks.register({
              name:
                'async-hook',

              operation:
                'beforeCreate',

              handler:
                async () => {

                  await new Promise(
                    resolve =>
                      setTimeout(
                        resolve,
                        10,
                      ),
                  );

                  events.push(
                    'completed',
                  );
                },

              priority:
                10,

              enabled:
                true,
            });

            await hooks.execute(
              'beforeCreate',
              {
                entity:
                  'User',
              },
            );

            expect(
              events,
            ).toEqual([
              'completed',
            ]);
          },
        );

        it(
          'should execute async hooks sequentially',
          async () => {

            const events:
              string[] = [];

            hooks.register({
              name:
                'first',

              operation:
                'beforeCreate',

              handler:
                async () => {

                  events.push(
                    'first-start',
                  );

                  await new Promise(
                    resolve =>
                      setTimeout(
                        resolve,
                        20,
                      ),
                  );

                  events.push(
                    'first-end',
                  );
                },

              priority:
                1,

              enabled:
                true,
            });

            hooks.register({
              name:
                'second',

              operation:
                'beforeCreate',

              handler:
                async () => {

                  events.push(
                    'second-start',
                  );

                  events.push(
                    'second-end',
                  );
                },

              priority:
                2,

              enabled:
                true,
            });

            await hooks.execute(
              'beforeCreate',
              {
                entity:
                  'User',
              },
            );

            expect(
              events,
            ).toEqual([
              'first-start',
              'first-end',
              'second-start',
              'second-end',
            ]);
          },
        );
      },
    );

    // ========================================================
    // PRIORITY
    // ========================================================

    describe(
      'Hook priority',
      () => {

        it(
          'should execute hooks according to priority',
          async () => {

            const execution:
              string[] = [];

            hooks.register({
              name:
                'third',

              operation:
                'beforeCreate',

              handler:
                () => {
                  execution.push(
                    'third',
                  );
                },

              priority:
                30,

              enabled:
                true,
            });

            hooks.register({
              name:
                'first',

              operation:
                'beforeCreate',

              handler:
                () => {
                  execution.push(
                    'first',
                  );
                },

              priority:
                10,

              enabled:
                true,
            });

            hooks.register({
              name:
                'second',

              operation:
                'beforeCreate',

              handler:
                () => {
                  execution.push(
                    'second',
                  );
                },

              priority:
                20,

              enabled:
                true,
            });

            await hooks.execute(
              'beforeCreate',
              {
                entity:
                  'User',
              },
            );

            expect(
              execution,
            ).toEqual([
              'first',
              'second',
              'third',
            ]);
          },
        );
      },
    );

    // ========================================================
    // ENABLE / DISABLE
    // ========================================================

    describe(
      'Hook enable and disable',
      () => {

        it(
          'should skip disabled hooks',
          async () => {

            const handler =
              jest.fn();

            hooks.register({
              name:
                'disabled-hook',

              operation:
                'beforeCreate',

              handler,

              priority:
                10,

              enabled:
                false,
            });

            await hooks.execute(
              'beforeCreate',
              {
                entity:
                  'User',
              },
            );

            expect(
              handler,
            ).not.toHaveBeenCalled();
          },
        );

        it(
          'should enable a disabled hook',
          async () => {

            const handler =
              jest.fn();

            hooks.register({
              name:
                'toggle-hook',

              operation:
                'beforeCreate',

              handler,

              priority:
                10,

              enabled:
                false,
            });

            expect(
              hooks.enable(
                'toggle-hook',
                'beforeCreate',
              ),
            ).toBe(
              true,
            );

            await hooks.execute(
              'beforeCreate',
              {
                entity:
                  'User',
              },
            );

            expect(
              handler,
            ).toHaveBeenCalledTimes(
              1,
            );
          },
        );

        it(
          'should disable an enabled hook',
          async () => {

            const handler =
              jest.fn();

            hooks.register({
              name:
                'toggle-hook',

              operation:
                'beforeCreate',

              handler,

              priority:
                10,

              enabled:
                true,
            });

            hooks.disable(
              'toggle-hook',
              'beforeCreate',
            );

            await hooks.execute(
              'beforeCreate',
              {
                entity:
                  'User',
              },
            );

            expect(
              handler,
            ).not.toHaveBeenCalled();
          },
        );
      },
    );

    // ========================================================
    // UNREGISTER
    // ========================================================

    describe(
      'Hook removal',
      () => {

        it(
          'should unregister a hook',
          () => {

            hooks.register({
              name:
                'removable',

              operation:
                'beforeCreate',

              handler:
                jest.fn(),

              priority:
                10,

              enabled:
                true,
            });

            const result =
              hooks.unregister(
                'removable',
                'beforeCreate',
              );

            expect(
              result,
            ).toBe(
              true,
            );

            expect(
              hooks.getHooks(
                'beforeCreate',
              ),
            ).toHaveLength(
              0,
            );
          },
        );

        it(
          'should return false when hook does not exist',
          () => {

            expect(
              hooks.unregister(
                'unknown',
                'beforeCreate',
              ),
            ).toBe(
              false,
            );
          },
        );
      },
    );

    // ========================================================
    // ERROR HANDLING
    // ========================================================

    describe(
      'Hook errors',
      () => {

        it(
          'should propagate hook errors',
          async () => {

            const error =
              new Error(
                'Hook failed',
              );

            hooks.register({
              name:
                'failing-hook',

              operation:
                'beforeCreate',

              handler:
                () => {
                  throw error;
                },

              priority:
                10,

              enabled:
                true,
            });

            await expect(
              hooks.execute(
                'beforeCreate',
                {
                  entity:
                    'User',
                },
              ),
            ).rejects.toThrow(
              'Hook failed',
            );
          },
        );

        it(
          'should stop subsequent hooks after failure',
          async () => {

            const first =
              jest.fn(
                () => {
                  throw new Error(
                    'first failed',
                  );
                },
              );

            const second =
              jest.fn();

            hooks.register({
              name:
                'first',

              operation:
                'beforeCreate',

              handler:
                first,

              priority:
                1,

              enabled:
                true,
            });

            hooks.register({
              name:
                'second',

              operation:
                'beforeCreate',

              handler:
                second,

              priority:
                2,

              enabled:
                true,
            });

            await expect(
              hooks.execute(
                'beforeCreate',
                {
                  entity:
                    'User',
                },
              ),
            ).rejects.toThrow(
              'first failed',
            );

            expect(
              first,
            ).toHaveBeenCalled();

            expect(
              second,
            ).not.toHaveBeenCalled();
          },
        );

        it(
          'should record failed hook execution',
          async () => {

