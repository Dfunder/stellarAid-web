                true,
            });

            hooks.register({
              name:
                'update',

              operation:
                'beforeUpdate',

              handler:
                updateHook,

              priority:
                10,

              enabled:
                true,
            });

            hooks.register({
              name:
                'delete',

              operation:
                'beforeDelete',

              handler:
                deleteHook,

              priority:
                10,

              enabled:
                true,
            });

            await hooks.execute(
              'beforeCreate',
              {
                entity:
                  'User',
              },
            );

            expect(
              createHook,
            ).toHaveBeenCalled();

            expect(
              updateHook,
            ).not.toHaveBeenCalled();

            expect(
              deleteHook,
            ).not.toHaveBeenCalled();
          },
        );
      },
    );

    // ========================================================
    // EXECUTION LOG
    // ========================================================

    describe(
      'Hook execution logging',
      () => {

        it(
          'should record successful execution',
          async () => {

            hooks.register({
              name:
                'logged-hook',

              operation:
                'beforeCreate',

              handler:
                jest.fn(),

              priority:
                10,

              enabled:
                true,
            });

            await hooks.execute(
              'beforeCreate',
              {
                entity:
                  'User',
              },
            );

            expect(
              hooks.getExecutionLog(),
            ).toEqual([
              'beforeCreate:logged-hook:start',

              'beforeCreate:logged-hook:success',
            ]);
          },
        );
      },
    );

    // ========================================================
    // EMPTY HOOK SET
    // ========================================================

    describe(
      'Empty hook behavior',
      () => {

        it(
          'should resolve when no hooks are registered',
          async () => {

            await expect(
              hooks.execute(
                'beforeCreate',
                {
                  entity:
                    'User',
                },
              ),
            ).resolves.toBeUndefined();
          },
        );

        it(
          'should return an empty hook list',
          () => {

            expect(
              hooks.getHooks(
                'afterDelete',
              ),
            ).toEqual([]);
          },
        );
      },
    );

    // ========================================================
    // CONTEXT IMMUTABILITY
    // ========================================================

    describe(
      'Hook context',
      () => {

        it(
          'should provide operation-specific context',
          async () => {

            const handler =
              jest.fn();

            hooks.register({
              name:
                'operation-check',

              operation:
                'afterUpdate',

              handler,

              priority:
                10,

              enabled:
                true,
            });

            await hooks.execute(
              'afterUpdate',
              {
                entity:
                  'Order',

                entityId:
                  'order-1',
              },
            );

            expect(
              handler.mock.calls[0][0]
                .operation,
            ).toBe(
              'afterUpdate',
            );

            expect(
              handler.mock.calls[0][0]
                .entity,
            ).toBe(
              'Order',
            );
          },
        );
      },
    );

    // ========================================================
    // DUPLICATE HOOK NAMES
    // ========================================================

    describe(
      'Duplicate hook registration',
      () => {

        it(
          'should preserve independently registered hooks',
          async () => {

            const first =
              jest.fn();

            const second =
              jest.fn();

            hooks.register({
              name:
                'same-name',

              operation:
                'beforeCreate',

              handler:
                first,

              priority:
                10,

              enabled:
                true,
            });

            hooks.register({
              name:
                'same-name',

              operation:
                'beforeCreate',

              handler:
                second,

              priority:
                20,

              enabled:
                true,
            });

            await hooks.execute(
              'beforeCreate',
              {
                entity:
                  'User',
              },
            );

            expect(
              first,
            ).toHaveBeenCalled();

            expect(
              second,
            ).toHaveBeenCalled();
          },
        );
      },
    );

    // ========================================================
    // CLEAR
    // ========================================================

    describe(
      'Hook cleanup',
      () => {

        it(
          'should clear all hooks',
          async () => {

            const handler =
              jest.fn();

            hooks.register({
              name:
                'temporary',

              operation:
                'beforeCreate',

              handler,

              priority:
                10,

              enabled:
                true,
            });

            hooks.clear();

            await hooks.execute(
              'beforeCreate',
              {
                entity:
                  'User',
              },
            );

            expect(
              handler,
            ).not.toHaveBeenCalled();

            expect(
              hooks.getHooks(
                'beforeCreate',
              ),
            ).toHaveLength(
              0,
            );
          },
        );
      },
    );
  },
);

