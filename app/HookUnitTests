                },

              priority:
                10,

              enabled:
                true,
            });

            await expect(
              hooks.execute(
                'beforeCreate',
                {
                  entity:
                    'User',
                },
              ),
            ).rejects.toThrow();

            expect(
              hooks.getExecutionLog(),
            ).toContain(
              'beforeCreate:failure-hook:failure',
            );
          },
        );
      },
    );

    // ========================================================
    // LIFECYCLE HOOKS
    // ========================================================

    describe(
      'Entity lifecycle hooks',
      () => {

