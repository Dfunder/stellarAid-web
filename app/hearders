// ============================================================
// SECURITY HEADERS CONFIGURATION
// ============================================================

export interface SecurityHeadersOptions {

  /*
   * Prevent browsers from MIME-sniffing responses.
   */
  contentTypeOptions?: boolean;

  /*
   * Prevent the page from being embedded in frames.
   */
  frameOptions?: 'DENY' | 'SAMEORIGIN';

  /*
   * Enable browser XSS protection where supported.
   */
  xssProtection?: boolean;

  /*
   * Control the amount of referrer information sent.
   */
  referrerPolicy?: string;

  /*
   * Prevent browsers from loading resources over HTTP when
   * the application is served over HTTPS.
   */
  contentSecurityPolicy?: string;

  /*
   * Enable HTTP Strict Transport Security.
   *
   * IMPORTANT:
   * Only enable this when the application is permanently
   * available through HTTPS.
   */
  hsts?: boolean;

  /*
   * Number of seconds browsers should remember HTTPS.
   */
  hstsMaxAge?: number;

  /*
   * Include subdomains in HSTS policy.
   */
  hstsIncludeSubDomains?: boolean;

  /*
   * Allow HSTS to be submitted to browser preload lists.
   */
  hstsPreload?: boolean;

  /*
   * Prevent cross-origin resource abuse.
   */
  crossOriginResourcePolicy?: string;

  /*
   * Control whether the document can be loaded cross-origin.
   */
  crossOriginOpenerPolicy?: string;

  /*
   * Control access to browser capabilities such as camera,
   * microphone and geolocation.
   */
  permissionsPolicy?: string;
}

// ============================================================
// DEFAULT CONFIGURATION
// ============================================================

const DEFAULT_SECURITY_OPTIONS:
  Required<SecurityHeadersOptions> = {

  contentTypeOptions:
    true,

  frameOptions:
    'DENY',

  xssProtection:
    true,

  referrerPolicy:
    'strict-origin-when-cross-origin',

  contentSecurityPolicy:
    [
      "default-src 'self'",
      "base-uri 'self'",
      "form-action 'self'",
      "frame-ancestors 'none'",
      "object-src 'none'",
      "script-src 'self'",
      "style-src 'self'",
      "img-src 'self' data: https:",
      "font-src 'self' data: https:",
      "connect-src 'self'",
    ].join('; '),

  hsts:
    true,

  hstsMaxAge:
    31536000,

  hstsIncludeSubDomains:
    true,

  hstsPreload:
    true,

  crossOriginResourcePolicy:
    'same-origin',

  crossOriginOpenerPolicy:
    'same-origin',

  permissionsPolicy:
    [
      'camera=()',
      'microphone=()',
      'geolocation=()',
      'payment=()',
      'usb=()',
      'magnetometer=()',
      'gyroscope=()',
      'accelerometer=()',
    ].join(', '),
};

// ============================================================
// SECURITY HEADERS MIDDLEWARE
// ============================================================

@Injectable()
export class SecurityHeadersMiddleware
  implements NestMiddleware {

  private readonly options:
    Required<SecurityHeadersOptions>;

  constructor(
    options:
      SecurityHeadersOptions = {},
  ) {

    this.options = {
      ...DEFAULT_SECURITY_OPTIONS,
      ...options,
    };
  }

  // ==========================================================
  // MIDDLEWARE
  // ==========================================================

  use(
    request: Request,
    response: Response,
    next: NextFunction,
  ): void {

    // --------------------------------------------------------
    // X-CONTENT-TYPE-OPTIONS
    // --------------------------------------------------------

    if (
      this.options
        .contentTypeOptions
    ) {

      response.setHeader(
        'X-Content-Type-Options',
        'nosniff',
      );
    }

    // --------------------------------------------------------
    // X-FRAME-OPTIONS
    // --------------------------------------------------------

    if (
      this.options.frameOptions
    ) {

      response.setHeader(
        'X-Frame-Options',
        this.options.frameOptions,
      );
    }

    // --------------------------------------------------------
    // X-XSS-PROTECTION
    // --------------------------------------------------------

    /*
     * This header is deprecated by modern browsers, but can
     * still be useful for older browser environments.
     *
     * CSP is the primary modern XSS defense.
     */

    if (
      this.options.xssProtection
    ) {

      response.setHeader(
        'X-XSS-Protection',
        '1; mode=block',
      );
    }

    // --------------------------------------------------------
    // REFERRER-POLICY
    // --------------------------------------------------------

    response.setHeader(
      'Referrer-Policy',
      this.options.referrerPolicy,
    );

    // --------------------------------------------------------
    // CONTENT-SECURITY-POLICY
    // --------------------------------------------------------

    if (
      this.options
        .contentSecurityPolicy
    ) {

      response.setHeader(
        'Content-Security-Policy',
        this.options
          .contentSecurityPolicy,
      );
    }

    // --------------------------------------------------------
    // HSTS
    // --------------------------------------------------------

    if (
      this.options.hsts
    ) {

      let value =
        `max-age=${this.options.hstsMaxAge}`;

      if (
        this.options
          .hstsIncludeSubDomains
      ) {

        value +=
          '; includeSubDomains';
      }

      if (
        this.options.hstsPreload
      ) {

        value +=
          '; preload';
      }

      response.setHeader(
        'Strict-Transport-Security',
        value,
      );
    }

    // --------------------------------------------------------
    // CROSS-ORIGIN-RESOURCE-POLICY
    // --------------------------------------------------------

    response.setHeader(
      'Cross-Origin-Resource-Policy',
      this.options
        .crossOriginResourcePolicy,
    );

    // --------------------------------------------------------
    // CROSS-ORIGIN-OPENER-POLICY
    // --------------------------------------------------------

    response.setHeader(
      'Cross-Origin-Opener-Policy',
      this.options
        .crossOriginOpenerPolicy,
    );

    // --------------------------------------------------------
    // PERMISSIONS-POLICY
    // --------------------------------------------------------

    response.setHeader(
      'Permissions-Policy',
      this.options
        .permissionsPolicy,
    );

    // --------------------------------------------------------
    // REMOVE TECHNOLOGY DISCLOSURE
    // --------------------------------------------------------

    /*
     * Express may expose:
     *
     * X-Powered-By: Express
     *
     * Remove it so the server implementation is not
     * unnecessarily disclosed.
     */

    response.removeHeader(
      'X-Powered-By',
    );

    next();
  }
}

// ============================================================
// SECURITY HEADERS SERVICE
// ============================================================

@Injectable()
export class SecurityHeadersService {

  private readonly headers = [
    'X-Content-Type-Options',
    'X-Frame-Options',
    'X-XSS-Protection',
    'Referrer-Policy',
    'Content-Security-Policy',
    'Strict-Transport-Security',
    'Cross-Origin-Resource-Policy',
    'Cross-Origin-Opener-Policy',
    'Permissions-Policy',
  ];

  // ==========================================================
  // GET EXPECTED HEADERS
  // ==========================================================

  getExpectedHeaders(): string[] {

    return [
      ...this.headers,
    ];
  }

  // ==========================================================
  // VALIDATE RESPONSE
  // ==========================================================

  validate(
    response: Response,
  ): {
    secure: boolean;
    missing: string[];
  } {

    const missing =
      this.headers.filter(
        header =>
          !response.getHeader(
            header,
          ),
      );

    return {
      secure:
        missing.length === 0,

      missing,
    };
  }
}

