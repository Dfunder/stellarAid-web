@Controller('security')
export class SecurityController {

  @Get('headers')
  getHeaders() {

    return {
      success:
        true,

      message:
        'Security headers are enabled',
    };
  }

  @Get('health')
  health() {

    return {
      status:
        'ok',
    };
  }
}

// ============================================================
// MODULE
// ============================================================

@Module({
  controllers: [
    SecurityController,
  ],

  providers: [
    SecurityHeadersService,
  ],
})
export class SecurityModule {}

