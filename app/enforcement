/*
 *
 * If Nginx is used as the TLS termination layer:
 *
 *
 * server {
 *
 *     listen 80;
 *
 *     server_name api.example.com;
 *
 *     return 308 https://$host$request_uri;
 * }
 *
 *
 *
 * server {
 *
 *     listen 443 ssl;
 *
 *     server_name api.example.com;
 *
 *     ssl_certificate
 *       /etc/ssl/cert.pem;
 *
 *     ssl_certificate_key
 *       /etc/ssl/key.pem;
 *
 *     location / {
 *
 *         proxy_pass
 *           http://nestjs:3000;
 *
 *         proxy_set_header
 *           Host $host;
 *
 *         proxy_set_header
 *           X-Forwarded-Proto $scheme;
 *
 *         proxy_set_header
 *           X-Forwarded-For $proxy_add_x_forwarded_for;
 *
 *         proxy_set_header
 *           X-Real-IP $remote_addr;
 *     }
 * }
 *
 */

// ============================================================
// CLOUD LOAD BALANCER
// ============================================================

/*
 *
 * If a cloud load balancer terminates TLS:
 *
 *
 * Client
 *   |
 *   | HTTPS
 *   ↓
 * Load Balancer
 *   |
 *   | HTTP internally
 *   ↓
 * NestJS
 *
 *
 * The load balancer must forward:
 *
 *
 * X-Forwarded-Proto: https
 *
 *
 * NestJS must trust the known proxy.
 *
 * Do NOT simply trust arbitrary client-supplied
 * X-Forwarded-Proto headers when the application is directly
 * exposed to the public internet.
 *
 */

// ============================================================
// TESTS
// ============================================================

describe(
  'HttpsEnforcementService',
  () => {

    let service:
      HttpsEnforcementService;

    beforeEach(
      () => {

        service =
          new HttpsEnforcementService();
      },
    );

    // ========================================================
    // HTTPS REQUEST
    // ========================================================

    it(
      'recognizes a secure request',
      () => {

        const request =
          {
            secure: true,

            protocol:
              'https',

            headers: {},
          } as Request;

        expect(
          service.isHttps(
            request,
          ),
        ).toBe(
          true,
        );
      },
    );

    // ========================================================
    // FORWARDED HTTPS
    // ========================================================

    it(
      'recognizes HTTPS behind a reverse proxy',
      () => {

        const request =
          {
            secure: false,

            protocol:
              'http',

            headers: {
              'x-forwarded-proto':
                'https',
            },
          } as Request;

        expect(
          service.isHttps(
            request,
          ),
        ).toBe(
          true,
        );
      },
    );

    // ========================================================
    // FORWARDED HTTP
    // ========================================================

    it(
      'rejects forwarded HTTP',
      () => {

        const request =
          {
            secure: false,

            protocol:
              'http',

            headers: {
              'x-forwarded-proto':
                'http',
            },
          } as Request;

        expect(
          service.isHttps(
            request,
          ),
        ).toBe(
          false,
        );
      },
    );

    // ========================================================
    // LOCALHOST
    // ========================================================

    it(
      'recognizes localhost',
      () => {

        const request =
          {
            hostname:
              'localhost',
          } as Request;

        expect(
          (service as any)
            .isLocalhost(
              'localhost',
            ),
        ).toBe(
          true,
        );
      },
    );

    // ========================================================
    // PRIVATE NETWORK
    // ========================================================

    it(
      'recognizes private IPv4 addresses',
      () => {

        expect(
          (service as any)
            .isPrivateAddress(
              '192.168.1.20',
            ),
        ).toBe(
          true,
        );

        expect(
          (service as any)
            .isPrivateAddress(
              '10.0.0.5',
            ),
        ).toBe(
          true,
        );

        expect(
          (service as any)
            .isPrivateAddress(
              '172.16.0.10',
            ),
        ).toBe(
          true,
        );
      },
    );

    // ========================================================
    // PUBLIC ADDRESS
    // ========================================================

    it(
      'does not classify public addresses as private',
      () => {

        expect(
          (service as any)
            .isPrivateAddress(
              '8.8.8.8',
            ),
        ).toBe(
          false,
        );
      },
    );
  },
);

// ============================================================
// MIDDLEWARE TESTS
// ============================================================

describe(
  'HttpsEnforcementMiddleware',
  () => {

    let middleware:
      HttpsEnforcementMiddleware;

    const httpsService =
      {
        getOptions:
          jest.fn(),

        shouldBypass:
          jest.fn(),

        isHttps:
          jest.fn(),

        buildHttpsUrl:
          jest.fn(),
      };

    beforeEach(
      () => {

        jest.clearAllMocks();

        middleware =
          new HttpsEnforcementMiddleware(
            httpsService as any,
          );
      },
    );

    // ========================================================
    // HTTPS PASSES
    // ========================================================

    it(
      'allows HTTPS requests',
      () => {

        httpsService
          .getOptions
          .mockReturnValue({
            enabled: true,
          });

        httpsService
          .shouldBypass
          .mockReturnValue(false);

        httpsService
          .isHttps
          .mockReturnValue(true);

        const next =
          jest.fn();

        const response =
          {
            status:
              jest.fn()
                .mockReturnThis(),

            set:
              jest.fn()
                .mockReturnThis(),

            end:
              jest.fn(),
          } as any;

        middleware.use(
          {} as Request,
          response,
          next,
        );

        expect(
          next,
        ).toHaveBeenCalled();

        expect(
          response.end,
        ).not.toHaveBeenCalled();
      },
    );

    // ========================================================
    // HTTP REDIRECT
    // ========================================================

    it(
      'redirects HTTP requests to HTTPS',
      () => {

        httpsService
          .getOptions
          .mockReturnValue({
            enabled: true,
          });

        httpsService
          .shouldBypass
          .mockReturnValue(false);

        httpsService
          .isHttps
          .mockReturnValue(false);

        httpsService
          .buildHttpsUrl
          .mockReturnValue(
            'https://example.com/test',
          );

        const next =
          jest.fn();

        const response =
          {
            status:
              jest.fn()
                .mockReturnThis(),

            set:
              jest.fn()
                .mockReturnThis(),

            end:
              jest.fn(),
          } as any;

        middleware.use(
          {} as Request,
          response,
          next,
        );

        expect(
          response.status,
        ).toHaveBeenCalledWith(
          308,
        );

        expect(
          response.set,
        ).toHaveBeenCalledWith(
          'Location',
          'https://example.com/test',
        );

        expect(
          response.end,
        ).toHaveBeenCalled();

        expect(
          next,
        ).not.toHaveBeenCalled();
      },
    );

    // ========================================================
    // DISABLED
    // ========================================================

    it(
      'does nothing when HTTPS enforcement is disabled',
      () => {

        httpsService
          .getOptions
          .mockReturnValue({
            enabled: false,
          });

        const next =
          jest.fn();

        const response =
          {
            status:
              jest.fn()
                .mockReturnThis(),

            set:
              jest.fn()
                .mockReturnThis(),

            end:
              jest.fn(),
          } as any;

        middleware.use(
          {} as Request,
          response,
          next,
        );

        expect(
          next,
        ).toHaveBeenCalled();

        expect(
          response.status,
        ).not.toHaveBeenCalled();
      },
    );
  },
);

