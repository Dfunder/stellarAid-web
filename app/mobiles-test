// ============================================================
// TYPES
// ============================================================

interface MobileUser {
  id: string;
  email: string;
  password: string;
  verified: boolean;
}

interface MobileSession {
  token: string;
  userId: string;
  deviceId: string;
}

interface MobileDevice {
  id: string;
  userId: string;
  platform: 'ios' | 'android';
  version: string;
  model: string;
}

// ============================================================
// IN-MEMORY MOBILE TEST DATABASE
// ============================================================

@Injectable()
class MobileE2ETestDatabase {

  private users =
    new Map<string, MobileUser>();

  private sessions =
    new Map<string, MobileSession>();

  private devices =
    new Map<string, MobileDevice>();

  private counters = {
    user: 0,
    session: 0,
  };

  reset(): void {

    this.users.clear();

    this.sessions.clear();

    this.devices.clear();

    this.counters = {
      user: 0,
      session: 0,
    };
  }

  createUser(
    email: string,
    password: string,
  ): MobileUser {

    const user: MobileUser = {
      id:
        `mobile-user-${++this.counters.user}`,

      email,

      password,

      verified:
        true,
    };

    this.users.set(
      user.id,
      user,
    );

    return user;
  }

  findUserByEmail(
    email: string,
  ): MobileUser | undefined {

    return Array.from(
      this.users.values(),
    ).find(
      user =>
        user.email === email,
    );
  }

  findUser(
    id: string,
  ): MobileUser | undefined {

    return this.users.get(
      id,
    );
  }

  createSession(
    userId: string,
    deviceId: string,
  ): MobileSession {

    const session: MobileSession = {

      token:
        `mobile-session-${++this.counters.session}`,

      userId,

      deviceId,
    };

    this.sessions.set(
      session.token,
      session,
    );

    return session;
  }

  getSession(
    token: string,
  ): MobileSession | undefined {

    return this.sessions.get(
      token,
    );
  }

  revokeSession(
    token: string,
  ): void {

    this.sessions.delete(
      token,
    );
  }

  registerDevice(
    device: MobileDevice,
  ): MobileDevice {

    this.devices.set(
      device.id,
      device,
    );

    return device;
  }

  getDevice(
    id: string,
  ): MobileDevice | undefined {

    return this.devices.get(
      id,
    );
  }
}

// ============================================================
// MOBILE AUTH SERVICE
// ============================================================

@Injectable()
class MobileAuthService {

  constructor(
    private readonly database:
      MobileE2ETestDatabase,
  ) {}

  register(
    email: string,
    password: string,
  ) {

    const existing =
      this.database.findUserByEmail(
        email,
      );

    if (existing) {

      return {
        status:
          409,

        body: {
          message:
            'User already exists',
        },
      };
    }

    const user =
      this.database.createUser(
        email,
        password,
      );

    return {
      status:
        201,

      body: {
        id:
          user.id,

        email:
          user.email,

        verified:
          user.verified,
      },
    };
  }

  login(
    email: string,
    password: string,
    deviceId: string,
  ) {

    const user =
      this.database.findUserByEmail(
        email,
      );

    if (
      !user ||
      user.password !== password
    ) {

      return {
        status:
          401,

        body: {
          message:
            'Invalid credentials',
        },
      };
    }

    const session =
      this.database.createSession(
        user.id,
        deviceId,
      );

    return {
      status:
        200,

      body: {
        accessToken:
          session.token,

        user: {
          id:
            user.id,

          email:
            user.email,
        },

        deviceId,
      },
    };
  }

  logout(
    token: string,
  ) {

    const session =
      this.database.getSession(
        token,
      );

    if (!session) {

      return {
        status:
          401,

        body: {
          message:
            'Invalid session',
        },
      };
    }

    this.database.revokeSession(
      token,
    );

    return {
      status:
        200,

      body: {
        success:
          true,
      },
    };
  }

  authenticate(
    token: string,
  ) {

    return this.database.getSession(
      token,
    );
  }
}

// ============================================================
// MOBILE API CONTROLLER
// ============================================================

@Controller('mobile')
class MobileE2EController {

  constructor(
    private readonly database:
      MobileE2ETestDatabase,

    private readonly auth:
      MobileAuthService,
  ) {}

  // ==========================================================
  // HEALTH CHECK
  // ==========================================================

  @Get('health')
  health() {

    return {
      status:
        'ok',

      platform:
        'mobile',

      api:
        'available',
    };
  }

  // ==========================================================
  // REGISTER
  // ==========================================================

  @Post('auth/register')
  register(
    @Body()
    body: {
      email: string;
      password: string;
    },
  ) {

    return this.auth.register(
      body.email,
      body.password,
    );
  }

  // ==========================================================
  // LOGIN
  // ==========================================================

  @Post('auth/login')
  login(
    @Body()
    body: {
      email: string;
      password: string;
      deviceId: string;
    },
  ) {

    return this.auth.login(
      body.email,
      body.password,
      body.deviceId,
    );
  }

  // ==========================================================
  // LOGOUT
  // ==========================================================

  @Post('auth/logout')
  logout(
    @Body()
    body: {
      accessToken: string;
    },
  ) {

    return this.auth.logout(
      body.accessToken,
    );
  }

  // ==========================================================
  // PROFILE
  // ==========================================================

  @Get('profile/:token')
  profile(
    @Param('token')
    token: string,
  ) {

    const session =
      this.auth.authenticate(
        token,
      );

    if (!session) {

      return {
        status:
          401,

        body: {
          message:
            'Unauthorized',
        },
      };
    }

    const user =
      this.database.findUser(
        session.userId,
      );

    return {
      status:
        200,

      body: {
        id:
          user?.id,

        email:
          user?.email,
      },
    };
  }
}

