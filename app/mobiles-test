    );

    // ========================================================
    // CLEANUP
    // ========================================================

    afterEach(
      () => {

        database.reset();
      },
    );

    afterAll(
      async () => {

        await app.close();
      },
    );

    // ========================================================
    // HEALTH
    // ========================================================

    describe(
      'Mobile API availability',
      () => {

        it(
          'should expose the mobile health endpoint',
          async () => {

            const response =
              await request(
                app.getHttpServer(),
              )
                .get(
                  '/mobile/health',
                )
                .expect(
                  200,
                );

            expect(
              response.body.status,
            ).toBe(
              'ok',
            );

            expect(
              response.body.platform,
            ).toBe(
              'mobile',
            );
          },
        );
      },
    );

    // ========================================================
    // REGISTRATION
    // ========================================================

    describe(
      'Mobile registration',
      () => {

        it(
          'should allow a mobile user to register',
          async () => {

            const response =
              await request(
                app.getHttpServer(),
              )
                .post(
                  '/mobile/auth/register',
                )
                .send({
                  email:
                    'mobile@example.com',

                  password:
                    'SecurePassword123!',
                })
                .expect(
                  201,
                );

            expect(
              response.body.email,
            ).toBe(
              'mobile@example.com',
            );

            expect(
              response.body.id,
            ).toBeDefined();
          },
        );

        it(
          'should reject duplicate registration',
          async () => {

            await request(
              app.getHttpServer(),
            )
              .post(
                '/mobile/auth/register',
              )
              .send({
                email:
                  'duplicate@example.com',

                password:
                  'Password123!',
              })
              .expect(
                201,
              );

            const response =
              await request(
                app.getHttpServer(),
              )
                .post(
                  '/mobile/auth/register',
                )
                .send({
                  email:
                    'duplicate@example.com',

                  password:
                    'Password123!',
                })
                .expect(
                  201,
                );

            expect(
              response.body.status,
            ).toBe(
              409,
            );
          },
        );
      },
    );

    // ========================================================
    // LOGIN
    // ========================================================

    describe(
      'Mobile login',
      () => {

        beforeEach(
          () => {

            database.createUser(
              'login@example.com',
              'Password123!',
            );
          },
        );

        it(
          'should login successfully',
          async () => {

            const response =
              await request(
                app.getHttpServer(),
              )
                .post(
                  '/mobile/auth/login',
                )
                .send({
                  email:
                    'login@example.com',

                  password:
                    'Password123!',

                  deviceId:
                    'iphone-test-device',
                })
                .expect(
                  201,
                );

            expect(
              response.body.accessToken,
            ).toBeDefined();

            expect(
              response.body.user.email,
            ).toBe(
              'login@example.com',
            );

            expect(
              response.body.deviceId,
            ).toBe(
              'iphone-test-device',
            );
          },
        );

        it(
          'should reject invalid credentials',
          async () => {

            const result =
              auth.login(
                'login@example.com',
                'wrong-password',
                'iphone-test-device',
              );

            expect(
              result.status,
            ).toBe(
              401,
            );
          },
        );

        it(
          'should bind login session to device',
          async () => {

            const result =
              auth.login(
                'login@example.com',
                'Password123!',
                'android-device-001',
              );

            expect(
              result.status,
            ).toBe(
              200,
            );

            expect(
              result.body.deviceId,
            ).toBe(
              'android-device-001',
            );
          },
        );
      },
    );

    // ========================================================
    // SESSION
    // ========================================================

    describe(
      'Mobile session lifecycle',
      () => {

        let token:
          string;

        beforeEach(
          () => {

            const user =
              database.createUser(
                'session@example.com',
                'Password123!',
              );

            const session =
              database.createSession(
                user.id,
                'test-device',
              );

            token =
              session.token;
          },
        );

        it(
          'should access the profile with a valid session',
          async () => {

            const response =
              await request(
                app.getHttpServer(),
              )
                .get(
                  `/mobile/profile/${token}`,
                )
                .expect(
                  200,
                );

            expect(
              response.body.email,
            ).toBe(
              'session@example.com',
            );
          },
        );

        it(
          'should reject an invalid session',
          async () => {

            const response =
              await request(
                app.getHttpServer(),
              )
                .get(
                  '/mobile/profile/invalid-token',
                )
                .expect(
                  200,
                );

            expect(
              response.body.status,
            ).toBe(
              401,
            );
          },
        );

        it(
          'should invalidate the session after logout',
          async () => {

            await request(
              app.getHttpServer(),
            )
              .post(
                '/mobile/auth/logout',
              )
              .send({
                accessToken:
                  token,
              });

            const session =
              database.getSession(
                token,
              );

            expect(
              session,
            ).toBeUndefined();
          },
        );
      },
    );

    // ========================================================
    // IOS DEVICE FLOW
    // ========================================================

    describe(
      'iOS mobile flow',
      () => {

        it(
          'should complete registration and login from iOS',
          async () => {

            const deviceId =
              'ios-e2e-device';

            await request(
              app.getHttpServer(),
            )
              .post(
                '/mobile/auth/register',
              )
              .send({
                email:
                  'ios@example.com',

                password:
                  'IOSPassword123!',
              })
              .expect(
                201,
              );

            const login =
              await request(
                app.getHttpServer(),
              )
                .post(
                  '/mobile/auth/login',
                )
                .send({
                  email:
                    'ios@example.com',

                  password:
                    'IOSPassword123!',

                  deviceId,
                })
                .expect(
                  201,
                );

            expect(
              login.body.accessToken,
            ).toBeDefined();

            expect(
              login.body.deviceId,
            ).toBe(
              deviceId,
            );

            const profile =
              await request(
                app.getHttpServer(),
              )
                .get(
                  `/mobile/profile/${login.body.accessToken}`,
                )
                .expect(
                  200,
                );

            expect(
              profile.body.email,
            ).toBe(
              'ios@example.com',
            );
          },
        );
      },
    );

    // ========================================================
    // ANDROID DEVICE FLOW
    // ========================================================

    describe(
      'Android mobile flow',
      () => {

        it(
          'should complete registration and login from Android',
          async () => {

            const deviceId =
              'android-e2e-device';

            await request(
              app.getHttpServer(),
            )
              .post(
                '/mobile/auth/register',
              )
              .send({
                email:
                  'android@example.com',

                password:
                  'AndroidPassword123!',
              })
              .expect(
                201,
              );

            const login =
              await request(
                app.getHttpServer(),
              )
                .post(
                  '/mobile/auth/login',
                )
                .send({
                  email:
                    'android@example.com',

                  password:
                    'AndroidPassword123!',

                  deviceId,
                })
                .expect(
                  201,
                );

            expect(
              login.body.accessToken,
            ).toBeDefined();

            expect(
              login.body.deviceId,
            ).toBe(
              deviceId,
            );
          },
        );
      },
    );

    // ========================================================
    // NETWORK FAILURE SIMULATION
    // ========================================================

    describe(
      'Network failure handling',
      () => {

        it(
          'should not create a session when authentication fails',
          async () => {

            const before =
              database.getSession(
                'invalid-token',
              );

            expect(
              before,
            ).toBeUndefined();

            const result =
              auth.login(
                'unknown@example.com',
                'Password123!',
                'offline-device',
              );

            expect(
              result.status,
            ).toBe(
              401,
            );

            const after =
              database.getSession(
                'invalid-token',
              );

            expect(
              after,
            ).toBeUndefined();
          },
        );
      },
    );

    // ========================================================
    // MULTIPLE DEVICES
    // ========================================================

    describe(
      'Multiple mobile devices',
      () => {

        it(
          'should allow separate sessions for separate devices',
          () => {

            const user =
              database.createUser(
                'multi@example.com',
                'Password123!',
              );

            const iosSession =
              database.createSession(
                user.id,
                'ios-device',
              );

            const androidSession =
              database.createSession(
                user.id,
                'android-device',
              );

            expect(
              iosSession.token,
            ).not.toBe(
              androidSession.token,
            );

            expect(
              iosSession.deviceId,
            ).toBe(
              'ios-device',
            );

            expect(
              androidSession.deviceId,
            ).toBe(
              'android-device',
            );
          },
        );

        it(
          'should revoke only the requested device session',
          () => {

            const user =
              database.createUser(
                'devices@example.com',
                'Password123!',
              );

            const first =
              database.createSession(
                user.id,
                'device-one',
              );

            const second =
              database.createSession(
                user.id,
                'device-two',
              );

            database.revokeSession(
              first.token,
            );

            expect(
              database.getSession(
                first.token,
              ),
            ).toBeUndefined();

            expect(
              database.getSession(
                second.token,
              ),
            ).toBeDefined();
          },
        );
      },
    );

    // ========================================================
    // DATA SAFETY
    // ========================================================

    describe(
      'Mobile response security',
      () => {

        it(
          'should never return the password in registration response',
          async () => {

            const response =
              await request(
                app.getHttpServer(),
              )
                .post(
                  '/mobile/auth/register',
                )
                .send({
                  email:
                    'security@example.com',

                  password:
                    'SecretPassword123!',
                })
                .expect(
                  201,
                );

            expect(
              response.body.password,
            ).toBeUndefined();
          },
        );

        it(
          'should never return the stored password during login',
          async () => {

            database.createUser(
              'secure-login@example.com',
              'SecretPassword123!',
            );

            const response =
              await request(
                app.getHttpServer(),
              )
                .post(
                  '/mobile/auth/login',
                )
                .send({
                  email:
                    'secure-login@example.com',

                  password:
                    'SecretPassword123!',

                  deviceId:
                    'secure-device',
                })
                .expect(
                  201,
                );

            expect(
              response.body.user.password,
            ).toBeUndefined();
          },
        );
      },
    );

    // ========================================================
    // E2E ACCEPTANCE CRITERIA
    // ========================================================

    describe(
      'Mobile E2E acceptance criteria',
      () => {

        it(
          'covers the complete mobile authentication journey',
          async () => {

            // ------------------------------------------------
            // STEP 1: REGISTER
            // ------------------------------------------------

            const registration =
              await request(
                app.getHttpServer(),
              )
                .post(
                  '/mobile/auth/register',
                )
                .send({
                  email:
                    'journey@example.com',

                  password:
                    'JourneyPassword123!',
                })
                .expect(
                  201,
                );

            expect(
              registration.body.id,
            ).toBeDefined();

            // ------------------------------------------------
            // STEP 2: LOGIN
            // ------------------------------------------------

            const login =
              await request(
                app.getHttpServer(),
              )
                .post(
                  '/mobile/auth/login',
                )
                .send({
                  email:
                    'journey@example.com',

                  password:
                    'JourneyPassword123!',

                  deviceId:
                    'journey-device',
                })
                .expect(
                  201,
                );

            const token =
              login.body.accessToken;

            expect(
              token,
            ).toBeDefined();

            // ------------------------------------------------
            // STEP 3: FETCH PROFILE
            // ------------------------------------------------

            const profile =
              await request(
                app.getHttpServer(),
              )
                .get(
                  `/mobile/profile/${token}`,
                )
                .expect(
                  200,
                );

            expect(
              profile.body.id,
            ).toBe(
              registration.body.id,
            );

            // ------------------------------------------------
            // STEP 4: LOGOUT
            // ------------------------------------------------

            await request(
              app.getHttpServer(),
            )
              .post(
                '/mobile/auth/logout',
              )
              .send({
                accessToken:
                  token,
              })
              .expect(
                201,
              );

            // ------------------------------------------------
            // STEP 5: SESSION MUST BE INVALID
            // ------------------------------------------------

            const session =
              database.getSession(
                token,
              );

            expect(
              session,
            ).toBeUndefined();
          },
        );
      },
    );
  },
);

