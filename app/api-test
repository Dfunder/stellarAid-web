              app.getHttpServer(),
            )
              .get(
                `/api/items/${id}`,
              )
              .set(
                'Authorization',
                'Bearer integration-test-token',
              )
              .expect(404);
          },
        );
      },
    );

    // ========================================================
    // UNKNOWN ROUTES
    // ========================================================

    describe(
      'Unknown routes',
      () => {

        it(
          'returns 404 for an unknown endpoint',
          async () => {

            await request(
              app.getHttpServer(),
            )
              .get(
                '/api/does-not-exist',
              )
              .set(
                'Authorization',
                'Bearer integration-test-token',
              )
              .expect(404);
          },
        );
      },
    );

    // ========================================================
    // CONTENT NEGOTIATION
    // ========================================================

    describe(
      'HTTP behavior',
      () => {

        it(
          'returns JSON responses',
          async () => {

            const response =
              await request(
                app.getHttpServer(),
              )
                .get(
                  '/api/items',
                )
                .set(
                  'Authorization',
                  'Bearer integration-test-token',
                )
                .expect(
                  'Content-Type',
                  /json/,
                );

            expect(
              response.body,
            ).toBeDefined();
          },
        );

        it(
          'supports JSON request bodies',
          async () => {

            const response =
              await request(
                app.getHttpServer(),
              )
                .post(
                  '/api/items',
                )
                .set(
                  'Authorization',
                  'Bearer integration-test-token',
                )
                .set(
                  'Content-Type',
                  'application/json',
                )
                .send(
                  JSON.stringify({
                    name:
                      'JSON Item',
                  }),
                )
                .expect(201);

            expect(
              response.body.data.name,
            ).toBe(
              'JSON Item',
            );
          },
        );
      },
    );
  },
);

