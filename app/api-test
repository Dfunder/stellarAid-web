export class CreateItemDto {

  name!: string;

  description?: string;
}

// ============================================================
// TEST ITEM
// ============================================================

export interface TestItem {

  id: string;

  name: string;

  description?: string;

  createdAt: Date;

  updatedAt: Date;
}

// ============================================================
// TEST REPOSITORY
// ============================================================

@Injectable()
export class TestItemRepository {

  private readonly items =
    new Map<string, TestItem>();

  private sequence = 0;

  // ==========================================================
  // CREATE
  // ==========================================================

  create(
    name: string,
    description?: string,
  ): TestItem {

    this.sequence++;

    const now =
      new Date();

    const item:
      TestItem = {

      id:
        `item-${this.sequence}`,

      name,

      description,

      createdAt:
        now,

      updatedAt:
        now,
    };

    this.items.set(
      item.id,
      item,
    );

    return item;
  }

  // ==========================================================
  // FIND ALL
  // ==========================================================

  findAll(): TestItem[] {

    return Array.from(
      this.items.values(),
    );
  }

  // ==========================================================
  // FIND ONE
  // ==========================================================

  findOne(
    id: string,
  ): TestItem | undefined {

    return this.items.get(
      id,
    );
  }

  // ==========================================================
  // UPDATE
  // ==========================================================

  update(
    id: string,
    changes: Partial<TestItem>,
  ): TestItem {

    const existing =
      this.items.get(id);

    if (!existing) {

      throw new NotFoundException(
        'Item not found',
      );
    }

    const updated:
      TestItem = {

      ...existing,

      ...changes,

      id:
        existing.id,

      createdAt:
        existing.createdAt,

      updatedAt:
        new Date(),
    };

    this.items.set(
      id,
      updated,
    );

    return updated;
  }

  // ==========================================================
  // DELETE
  // ==========================================================

  delete(
    id: string,
  ): void {

    if (
      !this.items.has(id)
    ) {

      throw new NotFoundException(
        'Item not found',
      );
    }

    this.items.delete(
      id,
    );
  }

  // ==========================================================
  // CLEAR
  // ==========================================================

  clear(): void {

    this.items.clear();

    this.sequence = 0;
  }
}

// ============================================================
// TEST SERVICE
// ============================================================

@Injectable()
export class TestItemService {

  constructor(
    private readonly repository:
      TestItemRepository,
  ) {}

  // ==========================================================
  // CREATE
  // ==========================================================

  create(
    dto: CreateItemDto,
  ): TestItem {

    if (
      !dto.name ||
      dto.name.trim().length === 0
    ) {

      throw new BadRequestException(
        'name is required',
      );
    }

    if (
      dto.name.length > 100
    ) {

      throw new BadRequestException(
        'name must not exceed 100 characters',
      );
    }

    return this.repository.create(
      dto.name.trim(),
      dto.description,
    );
  }

  // ==========================================================
  // FIND ALL
  // ==========================================================

  findAll(): TestItem[] {

    return this.repository.findAll();
  }

  // ==========================================================
  // FIND ONE
  // ==========================================================

  findOne(
    id: string,
  ): TestItem {

    const item =
      this.repository.findOne(
        id,
      );

    if (!item) {

      throw new NotFoundException(
        'Item not found',
      );
    }

    return item;
  }

  // ==========================================================
  // UPDATE
  // ==========================================================

  update(
    id: string,
    dto: Partial<CreateItemDto>,
  ): TestItem {

    this.findOne(id);

    if (
      dto.name !== undefined &&
      dto.name.trim().length === 0
    ) {

      throw new BadRequestException(
        'name cannot be empty',
      );
    }

    return this.repository.update(
      id,
      {
        name:
          dto.name?.trim(),

        description:
          dto.description,
      },
    );
  }

  // ==========================================================
  // DELETE
  // ==========================================================

  delete(
    id: string,
  ): void {

    this.repository.delete(
      id,
    );
  }
}

// ============================================================
// AUTHENTICATION MIDDLEWARE
// ============================================================

@Injectable()
export class TestAuthMiddleware {

  use(
    request: Request,
    response: Response,
    next: NextFunction,
  ): void {

    const authorization =
      request.headers.authorization;

    /*
     * Public routes are handled by the controller.
     *
     * Protected API routes require:
     *
     * Authorization: Bearer integration-test-token
     */

    if (
      request.path ===
      '/api/health'
    ) {

      next();

      return;
    }

    if (
      authorization !==
      'Bearer integration-test-token'
    ) {

      response
        .status(401)
        .json({
          statusCode:
            401,

          message:
            'Unauthorized',
        });

      return;
    }

    next();
  }
}

// ============================================================
// SECURITY HEADERS MIDDLEWARE
// ============================================================

@Injectable()
export class TestSecurityHeadersMiddleware {

  use(
    request: Request,
    response: Response,
    next: NextFunction,
  ): void {

    response.setHeader(
      'X-Content-Type-Options',
      'nosniff',
    );

    response.setHeader(
      'X-Frame-Options',
      'DENY',
    );

    response.setHeader(
      'Referrer-Policy',
      'strict-origin-when-cross-origin',
    );

    response.setHeader(
      'Content-Security-Policy',
      "default-src 'none'",
    );

    response.removeHeader(
      'X-Powered-By',
    );

    next();
  }
}

